{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vit-viz",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "viz/vit/serve.py"
      ],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "gaze",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "viz/vit/serve.py",
        "--dir",
        "viz/gaze/web"
      ],
      "port": 8766,
      "autoPort": true
    },
    {
      "name": "dreams",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "viz/vit/serve.py",
        "--dir",
        "viz/dreams/web"
      ],
      "port": 8767,
      "autoPort": true
    }
  ]
}
